#!/bin/sh
cd "${0%/*}" || exit                                # Run from this directory
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions        # Tutorial run functions
#------------------------------------------------------------------------------

rm -rf input_ellipse2D
rm -rf meshMotion_ellipse2D

echo Create the machine learning mesh motion case
(
    cp -r ellipse2D input_ellipse2D

    cd input_ellipse2D
    echo Create .foam file for visualization in ParaView 
    touch case.foam
    
    echo Set mesh motion settings to MachineLearning mesh motion
    cp constant/dynamicMeshDict.smartsim constant/dynamicMeshDict

    echo Mesh and decompose the domain
    ./Allrun.mesh

    cd ..

    echo Run the smartsim_driver that coordinates Machine Learning and CFD 
    python tmop_smartsim_driver.py --case input_ellipse2D

    cd meshMotion_input_ellipse2D/input_ellipse2D

    # Compute the mesh quality fields 
    runParallel checkMesh -writeFields '(nonOrthoAngle skewness cellVolume)' #-time '0:'
    
    # Sample the mesh quality fields
    # runParallel postProcess -fields '(nonOrthoAngle skewness cellVolume)' \
    #     -funcs '(fieldMinMax volFieldValue(volAverage,nonOrthoAngle) volFieldValue(volAverage,skewness) volFieldValue(volAverage,cellVolume))'  -time '0:' #-noZero
    runParallel postProcess -dict system/postProcessDict #-time '0:'
    
    # Generate plots of mesh quality samples 
    python post_process.py
)

#------------------------------------------------------------------------------
